{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "biome check --write ./src",
    "lint": "biome lint ./src",
    "lint:ci": "biome ci ./src",
    "lint:fsd": "steiger ./src",
    "type-check": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:api": "bun x --package typescript@5.9.3 --package openapi-typescript@7.13.0 openapi-typescript openapi.json -o src/shared/api/schema.d.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@hookform/resolvers": "^7.0.7",
    "@sentry/react": "^11.13.0",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "i18next": "^27.1.3",
    "i18next-browser-languagedetector": "^8.3.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.74.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-i18next": "^18.0.2",
    "react-resizable-panels": "^4.24.1",
    "read-excel-file": "^9.3.17",
    "recharts": "3.8.0",
    "shiki": "^4.6.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@biomejs/biome": "^2.6.8",
    "@feature-sliced/steiger-plugin": "^0.8.2",
