# 本檔複製為 .env.prod 後含有機密：請 `chmod 600 .env.prod`（.env.* 已在
# .gitignore，不會進版控）。
# 提醒：以 env_file 注入的機密會出現在容器環境變數，能執行 `docker inspect`
# 者可讀。單機、docker 存取權受控時可接受；多人共用 daemon 時再改用 Docker
# secrets / 外部 secrets manager。
# ===================
# Environment
# ===================
# 注意：ENV 決定 pydantic Settings 要載入哪個 .env 檔（config/settings/base.py
# 用 os.getenv("ENV") 選檔），所以它必須由「process 環境」提供 —— Docker 走
# compose 的 env_file 注入所以沒問題；裸機部署請先 `export ENV=prod`，
# 只寫在本檔內是無效的（雞生蛋：檔案被選中前就需要它）。
ENV=prod
# 給 manage.py / celery 讀的（非 Settings 欄位），同樣需由 process 環境提供。
DJANGO_SETTINGS_MODULE=config.settings.prod

# DEBUG 不是環境變數：由 settings module 固定（prod.py 恆為 False），
# 環境無法把 prod 切成 DEBUG。

# ===================
# Required Settings
# ===================

# Django
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=<generate-new-key>

# Database (請使用正式環境的資料庫連線)
# 外部託管 DB (RDS / Cloud SQL 等) 應走 TLS — 保留 ?sslmode=require
# （若透過同機 socket / 私網且確定不需 TLS 才移除）。
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ===================
# Production Settings
# ===================
ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# Frontend origins allowed to call this API cross-origin.
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# The API's own https origin(s) — required for the Django admin's CSRF check.
# 必須含 https:// scheme（Django 4.0+ 硬性要求）——填裸網域會在啟動的 system
# check 直接失敗（4_0.E001）。
CSRF_TRUSTED_ORIGINS=https://your-domain.com

# 信任哪些 proxy 設定的 X-Forwarded-*（client IP → per-IP 節流；scheme → SSL
# redirect）。預設 172.16.0.0/12 = 內建 caddy 從 compose bridge 網段連入，
# 不用調；改用其他反代時換成該 proxy 的 IP/CIDR。
# WARNING: 設 "*" 等於任何能直連 port 8000 的人都可偽造這些 header（繞過節流與
# SSL redirect）——僅在 port 8000 絕無可能繞過 proxy 直達時使用。
# 信任跳數由下方 NINJA_NUM_PROXIES 控制，兩者必須對應同一套拓撲。
FORWARDED_ALLOW_IPS=172.16.0.0/12

# ===================
# Caddy 反向代理（docker-compose.prod.yml 的 caddy service）
# ===================
# API 對外域名。拓撲：訪客 → Cloudflare 橘雲（proxied）→ Caddy（tls internal
# 自簽憑證，搭配 Cloudflare SSL mode「Full」）→ api。
# 需先在 Cloudflare 把該域名的 A record（橘雲）指向本機 IP，且主機 443 對外
# 可達。完整步驟（含 Cloudflare 端設定與 /admin 保護）見 docs/caddy.md。
# 注意：這不是 pydantic Settings 欄位 —— 由 compose 變數替換讀取（Makefile 會以
# --env-file 載入本檔）。不使用內建 Caddy 時：留空並刪除 compose 內的
# caddy service。
DOMAIN=api.your-domain.com

# 反代層數 = Cloudflare edge + Caddy 共 2 層（Caddyfile 的 trusted_proxies
# 已對應信任 Cloudflare IP 段）。改變拓撲（灰雲直連 Caddy → 1）時要同步調整。
NINJA_NUM_PROXIES=2

# Celery / Cache (Redis). Use authenticated AND TLS Redis in prod (rediss://,
# port 6380); an open broker lets anyone inject tasks and an open cache can be
# poisoned. Drop to redis:// (with requirepass) only on a trusted private network.
# NOTE: prod fails to boot if these are left as the dev defaults (redis://redis:...).
CELERY_BROKER_URL=rediss://:password@your-redis-host:6380/0
CACHE_URL=rediss://:password@your-redis-host:6380/1

# Use a psycopg3 connection pool (Postgres only). Recommended under high
# concurrency; disables persistent connections (CONN_MAX_AGE) when on.
DB_CONN_POOL=false

# Number of uvicorn (ASGI) workers (defaults to CPU+1 if unset).
# WEB_CONCURRENCY=4
# Number of Celery worker processes per container (compose command default: 4).
# CELERY_CONCURRENCY=4
# uvicorn 綁定的位址。compose 部署不用設（entrypoint 已綁 0.0.0.0）；但裸機/
# 跨機反代（不經 compose）時必須設 0.0.0.0，否則 uvicorn 預設綁 127.0.0.1，
# 反代（在別台機器或別的 network namespace）會連不到。
# UVICORN_HOST=0.0.0.0

# 文章發布 webhook：文章從 draft → published 時，Celery task 會 POST 到此 URL。
# 留空（或不設定）即停用。
# ARTICLE_PUBLISHED_WEBHOOK_URL=https://example.com/webhooks/article-published

# LINE Login channel — required in prod (see config/settings/base.py::_validate_prod).
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# Must be the real frontend origin — required in prod.
FRONTEND_BASE_URL=https://your-frontend-domain.com

# 注意：/admin/ 沒有 rate limit。建議在反向代理層對 /admin/ 做 IP allowlist
# （或未來改用 2FA），避免管理介面暴露於暴力破解。

# ===================
# Tuning（皆有合理預設，不需要調整時可整段不設）
# ===================
# Bearer token 有效天數。
# AUTH_TOKEN_TTL_DAYS=7
# Throttle rates（Django Ninja rate 字串："次數/單位"，單位 s/m/h/d）。
# THROTTLE_WRITE_RATE=30/m
# THROTTLE_LOGIN_RATE=10/m
# THROTTLE_REGISTER_RATE=5/h
# 分頁：預設每頁筆數與 ?page_size= 上限。
# PAGE_SIZE=20
# MAX_PAGE_SIZE=100
# NINJA_NUM_PROXIES 已設在上方 Caddy 區段（本拓撲固定 2 層）。設太低，攻擊者
# 可用 X-Forwarded-For 偽造來源 IP 繞過 per-IP 節流；設太高，會錯把 XFF 中的
# client 值當成來源 IP。多一層 CDN/LB 就 +1。
# GIT_COMMIT_SHA 不用手動設 —— prod image 於 build 時以 build arg 注入
# （make prod-build 會自動帶入 git rev-parse HEAD）。

# ===================
# 告警 / 可觀測性 —— 完整設定步驟見 docs/alerting.md
# ===================
# Sentry DSN。ENV=prod 時**必填**:留空會直接拒絕開機。
# 沒有錯誤追蹤的服務等於沒人看著,而「忘了設」和「決定不用」從外面看完全一樣,
# 所以真的不要就填 disabled(明確表態),不要留空。
#
# 光是填 DSN 只做到「錯誤有被記錄」。要讓錯誤真的通知到人,還要在 Sentry
# 建 alert rule 接 Slack —— 步驟見 docs/alerting.md「Sentry → Slack」。
SENTRY_DSN=
# Fraction of requests traced for performance monitoring (0.0–1.0). Keep low in prod.
SENTRY_TRACES_SAMPLE_RATE=0.1
# Fraction of traced transactions also profiled (0.0–1.0).
SENTRY_PROFILES_SAMPLE_RATE=0.0

# celery-beat 的心跳 URL(healthchecks.io / Better Stack / Cronitor 等)。
# beat 每 5 分鐘 ping 一次;beat 掛掉 → ping 停止 → 監控端告警。
# 這條補的是 Sentry 看不到的故障:排程沒跑不會拋例外,只會一片安靜。
# 留空停用。監控端的 grace period 請設得比 5 分鐘寬鬆(建議 15 分鐘)。
BEAT_HEARTBEAT_URL=

# Celery 佇列積壓超過這個訊息數就送 Sentry 告警。積壓時沒有任何一個任務會失敗
# (它們只是排隊排不到),所以不主動量測就永遠不會知道。設 0 停用。
CELERY_QUEUE_DEPTH_ALERT_THRESHOLD=1000
