# CI 用的 prod 環境變數 —— 唯一來源。全部是假值，刻意進版控（.gitignore 有 !.env.ci 例外），
# 也不會進 image（.dockerignore 排除 .env.*）。
#
# 使用者：.github/workflows/backend-ci.yml 的「check --deploy」與「smoke test」兩個步驟，
# 以及 config/test_ci_env.py（確保這份檔案能通過 Settings._validate_prod）。
# prod 新增必填變數時：在這裡加一行假值、在 .env.prod.example 補上說明；
# 漏了的話 `make test-local` 就會先失敗，不必等到 CI 的 docker job。
#
# 格式限制（docker --env-file 與 shell source 都要能讀）：KEY=VALUE、不加引號、
# 值裡不要有空白，註解只能獨立一行（不能寫在值後面）。
ENV=prod
DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=ci-deploy-check-only-not-a-real-secret-key-0123456789ABCDEF
DATABASE_URL=sqlite://:memory:
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com
CELERY_BROKER_URL=redis://ci-broker:6379/0
CACHE_URL=redis://ci-cache:6379/1
LINE_LOGIN_CHANNEL_ID=ci-line-channel-id
LINE_LOGIN_CHANNEL_SECRET=ci-line-channel-secret-not-real
FRONTEND_BASE_URL=https://app.example.com
SENTRY_DSN=disabled
# 以下只給 smoke test 的容器用：讓 uvicorn 綁 0.0.0.0（host 才連得到）、單一 worker。
UVICORN_HOST=0.0.0.0
WEB_CONCURRENCY=1
