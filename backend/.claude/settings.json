{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make all)",
      "Bash(make format)",
      "Bash(make lint)",
      "Bash(make type-check)",
      "Bash(make test*)",
      "Bash(uv run pytest*)",
      "Bash(uv run ruff*)",
      "Bash(uv run mypy*)",
      "Bash(make unused)",
      "Bash(make openapi)"
    ],
    "deny": [
      "Bash(make prod-*)",
      "Bash(*docker-compose.prod.yml*)",
      "Bash(git push*)",
      "Read(./.env.prod)",
      "Bash(*.env.prod*)",
      "Bash(make docker-clean*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)\"/.claude/hooks/block-human-only.sh"
          }
        ]
      }
    ]
  }
}
