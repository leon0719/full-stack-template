# ===================
# Environment
# ===================
# 注意：ENV 決定 pydantic Settings 要載入哪個 .env 檔（config/settings/base.py
# 用 os.getenv("ENV") 選檔）。未設定時預設就是 local，所以本地開發不用特別
# export；但若要跑 prod 設定，ENV 必須由 process 環境提供（見 .env.prod.example）。
ENV=local
# 給 manage.py / celery 讀的（非 Settings 欄位）。
DJANGO_SETTINGS_MODULE=config.settings.local

# DEBUG 不是環境變數：由 settings module 固定（local.py 恆為 True）。

# ===================
# Required Settings
# ===================

# Django
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your-secret-key-here

# Database
DATABASE_URL=postgresql://app:app@db:5432/app

# ===================
# Local Settings
# ===================
# 允許的 host（逗號分隔）。Docker 內健康檢查需要 localhost/127.0.0.1；
# host.docker.internal 供其他容器（或宿主機工具）連進 API 時使用。
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,host.docker.internal
# 允許跨域呼叫的前端 origin（逗號分隔）。3000 = Next.js/CRA、5173 = Vite 預設埠。
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# CSRF_TRUSTED_ORIGINS 僅 prod 使用（config/settings/prod.py），本地不用設。

# Celery
CELERY_BROKER_URL=redis://redis:6379/0

# Cache (Redis DB index separate from the Celery broker)
CACHE_URL=redis://redis:6379/1

# psycopg3 connection pool（Postgres 限定；本地通常不需要）。
# DB_CONN_POOL=false

# 文章發布 webhook：文章從 draft → published 時，Celery task 會 POST 到此 URL。
# 留空（或不設定）即停用。
# ARTICLE_PUBLISHED_WEBHOOK_URL=https://example.com/webhooks/article-published

# LINE Login channel (LINE Developers Console → your channel → Basic settings).
# Local testing needs a public HTTPS callback — see docs/development.md's
# "LINE 登入本地測試" section for the cloudflared tunnel steps.
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# Frontend origin the post-login redirect sends the browser back to.
FRONTEND_BASE_URL=http://localhost:5173

# ===================
# Tuning（皆有合理預設，不需要調整時可整段不設）
# ===================
# Bearer token 有效天數。
# AUTH_TOKEN_TTL_DAYS=7
# Throttle rates（Django Ninja rate 字串："次數/單位"，單位 s/m/h/d）。
# THROTTLE_WRITE_RATE=30/m
# THROTTLE_LOGIN_RATE=10/m
# 分頁：預設每頁筆數與 ?page_size= 上限。
# PAGE_SIZE=20
# MAX_PAGE_SIZE=100
# django-ninja 節流信任的反代層數——本地無反代，維持預設 1（prod 見 .env.prod.example）。
# NINJA_NUM_PROXIES=1
# GIT_COMMIT_SHA 不用設 —— 只有 prod image build 時會注入。

# ===================
# Sentry — 本地預設停用（DSN 留空即可，以下僅供對照 prod）
# ===================
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.0
# SENTRY_PROFILES_SAMPLE_RATE=0.0
