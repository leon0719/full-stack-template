{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make check*)",
      "Bash(make gen-api)"
    ],
    "deny": [
      "Bash(git push*)",
      "Bash(make deploy-frontend*)",
      "Bash(*deploy-frontend.sh*)",
      "Bash(aws *)",
      "Bash(*docker-compose.prod.yml*)",
      "Read(./backend/.env.prod)",
      "Read(./frontend/.env.prod*)",
      "Bash(*.env.prod*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-human-only.sh"
          }
        ]
      }
    ]
  }
}
