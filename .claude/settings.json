{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push*)",
      "Bash(make deploy-frontend*)",
      "Bash(*deploy-frontend.sh*)",
      "Bash(aws *)",
      "Bash(*docker-compose.prod.yml*)",
      "Read(./backend/.env.prod)",
      "Bash(*.env.prod*)"
    ]
  }
}
